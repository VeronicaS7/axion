

/* ==========================================================================
   AXION LESSON PLAYER REDESIGN
   ========================================================================== */

/* Markdown Content Styling */
.step-content-section h1,
.step-content-section h2,
.step-content-section h3 {
  font-family: var(--font-title);
  color: var(--text-primary);
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
  font-weight: 700;
}
.step-content-section h1 { font-size: 1.5rem; }
.step-content-section h2 { font-size: 1.25rem; }
.step-content-section h3 { font-size: 1.1rem; }
.step-content-section p {
  line-height: 1.6;
  margin-bottom: 1rem;
  color: var(--text-secondary);
}
.step-content-section ul, .step-content-section ol {
  margin-bottom: 1rem;
  padding-left: 1.5rem;
  color: var(--text-secondary);
}
.step-content-section li { margin-bottom: 0.5rem; }
.step-content-section strong {
  color: var(--text-primary);
  font-weight: 600;
}
.step-content-section img {
  max-width: 100%;
  border-radius: var(--radius-md);
  margin: 1rem 0;
  cursor: zoom-in;
}

/* Question Layout */
.exercise-statement {
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 1.5rem;
}
.exercise-image-container img {
  max-width: 100%;
  border-radius: var(--radius-md);
  margin-bottom: 1.5rem;
  cursor: zoom-in;
}

/* Alternative Cards */
.exercise-options-container {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.alt-card {
  display: flex;
  align-items: flex-start;
  padding: 1rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.02);
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
}
.alt-card:hover {
  border-color: rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.05);
}
.alt-card.selected {
  border-color: var(--primary);
  background: rgba(0, 132, 255, 0.1);
}
.alt-card.correct {
  border-color: var(--success);
  background: rgba(0, 200, 117, 0.1);
}
.alt-card.incorrect {
  border-color: var(--error);
  background: rgba(255, 59, 48, 0.1);
}
.alt-letter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
  font-weight: 700;
  margin-right: 1rem;
  flex-shrink: 0;
}
.alt-card.selected .alt-letter {
  background: var(--primary);
  color: #fff;
}
.alt-card.correct .alt-letter {
  background: var(--success);
  color: #fff;
}
.alt-card.incorrect .alt-letter {
  background: var(--error);
  color: #fff;
}
.alt-text {
  flex: 1;
  font-size: 0.95rem;
  line-height: 1.5;
  color: var(--text-secondary);
  white-space: pre-wrap;
}
.alt-card.selected .alt-text,
.alt-card.correct .alt-text,
.alt-card.incorrect .alt-text {
  color: var(--text-primary);
}

/* Modals for Hint/Professor */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(4px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}
.modal-content {
  background: #1e1e1e;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-lg);
  padding: 2rem;
  width: 90%;
  max-width: 500px;
  transform: translateY(20px);
  transition: all 0.3s ease;
}
.modal-overlay.active .modal-content {
  transform: translateY(0);
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.modal-title {
  font-family: var(--font-title);
  font-size: 1.25rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.modal-body {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}
.btn-close-modal {
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  padding: 0.5rem;
}
.btn-close-modal:hover {
  color: var(--text-primary);
}

/* Feedback Box adjustments */
.feedback-sheet {
  background: #2a2a2a;
  border-radius: var(--radius-md);
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}
.feedback-sheet.correct { border-left: 4px solid var(--success); }
.feedback-sheet.incorrect { border-left: 4px solid var(--error); }
.feedback-explanation-box {
  margin-top: 1rem;
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* Responsive Overrides */
@media (max-width: 768px) {
  .focused-lesson-body { padding: 1rem; }
  .lesson-card { padding: 1.5rem; }
  .alt-card { padding: 0.75rem; }
  .alt-letter { width: 24px; height: 24px; font-size: 0.9rem; margin-right: 0.75rem; }
  .focused-lesson-action-row { flex-wrap: wrap; }
  .focused-lesson-action-row button { flex: 1; min-width: 45%; }
  #btn-lesson-primary-action { flex: 2; min-width: 100%; margin-top: 0.5rem; }
}
